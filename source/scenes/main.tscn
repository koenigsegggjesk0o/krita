;
; scenes/main.tscn — Main scene untuk Feather-Krita app
;
; Layout (Feather 3D style):
;   ┌─────────────────────────────────────────────┐
;   │  TopBar (status, mirror indicators)         │
;   │              3D Viewport (Canvas)            │
;   │    [Guide Surface mesh]                      │
;   │    [3D Strokes root]                         │
;   │    [Joystick overlay - bottom-left]          │
;   ├──────────────────────────────────────────────┤
;   │  ContextMenu (changes per tool)              │
;   ├──────────────────────────────────────────────┤
;   │  BottomToolbar:                              │
;   │  [Draw][Erase][Shapes][Liquify][Select]      │
;   │  [Light][Export][Settings]                   │
;   └──────────────────────────────────────────────┘

[gd_scene load_steps=12 format=3 uid="uid://featherkrita_main"]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]

[sub_resource type="StandardMaterial3D" id="mat_guide"]
resource_name = "GuideSurfaceMaterial"
albedo_color = Color(0.6, 0.7, 0.9, 0.4)
transparency = 1
roughness = 0.8
metallic = 0.0

[sub_resource type="StandardMaterial3D" id="mat_stroke"]
resource_name = "StrokeMaterial"
albedo_color = Color(0.05, 0.05, 0.06, 1.0)
roughness = 0.5
metallic = 0.0

[sub_resource type="BoxMesh" id="mesh_light_helper"]
resource_name = "LightHelperMesh"
size = Vector3(0.2, 0.2, 0.2)

[sub_resource type="StandardMaterial3D" id="mat_light_helper"]
emission_enabled = true
emission = Color(1, 1, 0.6, 1)
emission_energy_multiplier = 2.0
albedo_color = Color(1, 1, 0.6, 1)

[sub_resource type="StyleBoxFlat" id="style_panel_bg"]
bg_color = Color(0.08, 0.08, 0.10, 0.92)
border_width_left = 0
border_width_top = 2
border_width_right = 0
border_width_bottom = 0
border_color = Color(0.2, 0.2, 0.25, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8

[sub_resource type="StyleBoxFlat" id="style_button_normal"]
bg_color = Color(0.15, 0.15, 0.18, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="style_button_pressed"]
bg_color = Color(0.30, 0.55, 0.90, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="style_button_hover"]
bg_color = Color(0.25, 0.25, 0.30, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="Theme" id="theme_feather"]
Button/colors/font_color = Color(0.9, 0.9, 0.9, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/font_sizes/font_size = 14
Button/styles/normal = SubResource("style_button_normal")
Button/styles/pressed = SubResource("style_button_pressed")
Button/styles/hover = SubResource("style_button_hover")

[sub_resource type="Environment" id="env_main"]
background_mode = 1
background_color = Color(0.12, 0.12, 0.14, 1)
ambient_light_source = 2
ambient_light_color = Color(0.3, 0.3, 0.35, 1)
ambient_light_energy = 0.4
tonemap_mode = 2
glow_enabled = true
glow_intensity = 0.6
glow_strength = 0.8
glow_bloom = 0.2
volumetric_fog_enabled = false

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.866, 0.5, 0, -0.5, 0.866, 0, 2.0, 4.0)
fov = 60.0
near = 0.05
far = 4000.0
current = true

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.7, -0.5, 0.5, 0, 0.7, 0.7, -0.7, -0.5, 0.5, 3, 5, 2)
light_color = Color(1, 0.96, 0.88, 1)
light_energy = 1.2
shadow_enabled = true
directional_shadow_max_distance = 50.0

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env_main")

[node name="GuideSurfaceMesh" type="MeshInstance3D" parent="."]
visible = true
material_override = SubResource("mat_guide")
mesh = null
; Mesh di-generate dari FeatherGuideSurface (GDExtension) saat runtime

[node name="StrokesRoot" type="Node3D" parent="."]
; Container untuk semua stroke meshes (1 MeshInstance3D per stroke)

[node name="LightHelper" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 5, 2)
mesh = SubResource("mesh_light_helper")
material_override = SubResource("mat_light_helper")
visible = false

[node name="UI" type="CanvasLayer" parent="."]
layer = 1

[node name="TopBar" type="Panel" parent="UI"]
anchors_preset = 10
anchor_right = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 40.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("style_panel_bg")

