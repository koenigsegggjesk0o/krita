[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/DrawButton" to="." method="_on_draw_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/EraseButton" to="." method="_on_erase_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/ShapesButton" to="." method="_on_shapes_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/LiquifyButton" to="." method="_on_liquify_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/SelectButton" to="." method="_on_select_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/LightButton" to="." method="_on_light_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/ExportButton" to="." method="_on_export_button_pressed"]
[connection signal="pressed" from="UI/BottomToolbar/ToolbarContainer/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="value_changed" from="UI/ContextMenu/ContextContainer/BrushSizeSlider" to="." method="_on_brush_size_changed"]
[connection signal="value_changed" from="UI/ContextMenu/ContextContainer/BrushOpacitySlider" to="." method="_on_brush_opacity_changed"]
[connection signal="color_changed" from="UI/ContextMenu/ContextContainer/ColorPickerButton" to="." method="_on_color_changed"]
[connection signal="pressed" from="UI/ContextMenu/ContextContainer/BrushPresetButton" to="." method="_on_brush_preset_button_pressed"]
[connection signal="pressed" from="UI/ShapeSelector/ShapeVBox/HBoxShapes/SphereBtn" to="." method="_on_shape_sphere_pressed"]
[connection signal="pressed" from="UI/ShapeSelector/ShapeVBox/HBoxShapes/CylinderBtn" to="." method="_on_shape_cylinder_pressed"]
