[node name="ContextContainer" type="HBoxContainer" parent="UI/ContextMenu"]
anchors_preset = 12
anchor_bottom = 1.0
anchor_right = 1.0
offset_left = 12.0
offset_top = 36.0
offset_right = -12.0
offset_bottom = -8.0
