min_value = 1.0
max_value = 200.0
value = 50.0
step = 1.0

[node name="BrushOpacityLabel" type="Label" parent="UI/ContextMenu/ContextContainer"]
custom_minimum_size = Vector2(80, 0)
text = "Opacity:"

[node name="BrushOpacitySlider" type="HSlider" parent="UI/ContextMenu/ContextContainer"]
custom_minimum_size = Vector2(180, 0)
min_value = 0.0
max_value = 1.0
value = 1.0
step = 0.01

[node name="ColorPickerButton" type="ColorPickerButton" parent="UI/ContextMenu/ContextContainer"]
custom_minimum_size = Vector2(60, 36)
color = Color(0, 0, 0, 1)

[node name="BrushPresetButton" type="Button" parent="UI/ContextMenu/ContextContainer"]
custom_minimum_size = Vector2(120, 36)
text = "Brush: Basic"

[node name="BottomToolbar" type="Panel" parent="UI"]
anchors_preset = 12
anchor_bottom = 1.0
anchor_right = 1.0
offset_left = 0.0
offset_top = -80.0
offset_right = 0.0
offset_bottom = 0.0
grow_vertical = 0
theme_override_styles/panel = SubResource("style_panel_bg")

[node name="ToolbarContainer" type="HBoxContainer" parent="UI/BottomToolbar"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 8.0
